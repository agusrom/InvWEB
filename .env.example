SECRET_KEY=cambiar-esta-clave
# Base exclusiva del sistema DNC. Debe ser MySQL; SQLite ya no se admite.
DATABASE_URL=mysql+pymysql://usuario:clave@127.0.0.1:3306/material_no_conforme?charset=utf8mb4

# Contraseñas utilizadas únicamente al crear las cuatro cuentas por primera vez.
# Después pueden cambiarse desde Administración → Usuarios y contraseñas.
PRODUCCION_PASSWORD=produccion
CALIDAD_PASSWORD=calidad
LOGISTICA_PASSWORD=logistica
ADMIN_PASSWORD=admin

PRODUCTIVE_DEMO_MODE=false
PRODUCTION_DATABASE_URL=mysql+pymysql://usuario:clave@127.0.0.1:3306/CGRSA?charset=utf8mb4

# Base que contiene turnos y tablaequipos.
# Si usa el mismo usuario/servidor que CGRSA, AUXILIARY_DATABASE_URL puede
# quedar vacío y se reutiliza PRODUCTION_DATABASE_URL.
AUXILIARY_DEMO_MODE=false
AUXILIARY_DATABASE_URL=
AUXILIARY_SCHEMA=NOMBRE_BD_AUXILIAR
TURNOS_TABLE=turnos
TURNOS_ID_COL=id
TURNOS_NOMBRE_COL=turno
EQUIPOS_TABLE=tablaequipos
EQUIPOS_NUMERO_COL=EQPO
EQUIPOS_DESCRIPCION_COL=DESC
EQUIPOS_CELULA_COL=CELULA

ERP_SCHEMA=CGRSA
PIEZAS_TABLE=produc01
PIEZA_CODIGO_COL=GCOD_
PIEZA_CLIENTE_COL=CCOD_
PIEZA_MATERIAL_COL=MATE_
PIEZA_DESCRIPCION_COL=DESC_
PIEZA_STOCK_COL=STOK_

ESTRUCTURA_TABLE=produc10
ESTRUCTURA_PADRE_COL=VCOD_
ESTRUCTURA_HIJO_COL=GCOD_
ESTRUCTURA_CANTIDAD_COL=QXUN_

OPERACIONES_TABLE=produc21
OPERACION_PIEZA_COL=GCOD_
OPERACION_CODIGO_COL=OPER_
OPERACION_TITULO_COL=CTITULO_

# Validación de HCP / lote.
CONTROL_HCP_SCHEMA=CGRSA
CONTROL_HCP_TABLE=controlo
CONTROL_HCP_PIEZA_COL=GCOD_
CONTROL_HCP_OPERACION_COL=OPER_
CONTROL_HCP_LOTE_COL=LOTE_
CONTROL_HCP_NUMERO_COL=NHCP_

# Maestro de proveedores para validar el número informado.
# Por defecto usa la misma conexión que las tablas productivas.
PROVEEDORES_SCHEMA=CGRSA
PROVEEDORES_TABLE=controlt
PROVEEDOR_NUMERO_COL=NPRV_
PROVEEDOR_DESCRIPCION_COL=DPRV_

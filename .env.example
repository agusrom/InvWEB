# Para usar MySQL, copiá esta configuración a .env y reemplazá los valores.
# No subas el archivo .env real a Git.
DATABASE_URL=mysql+pymysql://inventarios_user:TU_PASSWORD@127.0.0.1:3306/inventarios_web?charset=utf8mb4
# Se recomienda un usuario de sólo lectura para las tablas productivas.
PRODUCTION_DATABASE_URL=mysql+pymysql://consulta_user:TU_PASSWORD@127.0.0.1:3306/BASE_PRODUCTIVA?charset=utf8mb4
MOVIMIENTOS_DEBUG=0
MOVIMIENTOS_DEBUG_DETAIL=0
APP_HOST=0.0.0.0
APP_PORT=8000
# Clave requerida para reabrir inventarios cerrados.
INVENTORY_ADMIN_PASSWORD=CAMBIAR_ESTA_CLAVE
